{
  "automaticUpdates": false,
  "scanners": [
    {
      "id": "react",
      "source": "@groma/scanner-react@0.2.7",
      "include": [
        "crates/agmux-cli/src/companion_gui/ui/src/**/*.ts",
        "crates/agmux-cli/src/companion_gui/ui/src/**/*.tsx",
        "crates/agmux-cli/src/companion_gui/ui/tsconfig*.json",
        "crates/agmux-cli/src/companion_gui/ui/package.json",
        "crates/agmux-cli/src/companion_gui/ui/index.html"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "rust",
      "source": "@groma/scanner-rust@0.2.5",
      "include": [
        "Cargo.toml",
