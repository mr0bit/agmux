{
  "name": "@agmux/companion-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:state": "node --experimental-strip-types tests/state.test.ts && node --experimental-strip-types tests/design.test.ts && node --experimental-strip-types tests/motion.test.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "live": "npm run build && cargo build -p agmux-cli -p agmux-daemon && cargo run -p agmux-cli -- gui"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^8.0.2",
    "lucide-react": "^0.468.0",
    "motion": "^14.14.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-native-web": "^0.19.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
